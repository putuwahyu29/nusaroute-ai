# ============================================================
# NusaRoute AI — Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values.
# Never commit .env to version control!
#
# ------------------------------------------------------------
# GOOGLE GEMINI AI
# ------------------------------------------------------------
# How to get: https://aistudio.google.com/ -> Get API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Set to "false" to use live Gemini API (requires GEMINI_API_KEY above)
# Set to "true" only as emergency offline fallback (no API key needed)
USE_MOCK_AI=false

# Gemini model to use (recommended: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# ------------------------------------------------------------
# FIREBASE (Admin SDK — Server Side)
# ------------------------------------------------------------
# How to get:
# 1. Go to https://console.firebase.google.com/
# 2. Create a NEW project (e.g., "nusaroute-ai")
# 3. Project Settings -> Service Accounts
# 4. "Generate New Private Key" -> Download JSON
# 5. Paste the values from that JSON below:
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-service-account@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------
# GOOGLE MAPS
# ------------------------------------------------------------
# How to get: https://console.cloud.google.com/ -> APIs & Services
# Enable: Maps JavaScript API, Routes API (modern), Directions API (legacy fallback)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ------------------------------------------------------------
# SERVER & PRODUCTION SECURITY CONFIG
# ------------------------------------------------------------
PORT=3000
NODE_ENV=development
# Frontend origin for CORS (comma-separated for multiple domains)
CORS_ORIGIN=http://localhost:5173

# Machine-to-machine / Cloud Scheduler API key (generate a strong 32+ char random string in prod)
API_KEY=change_me_to_strong_random_api_key

# HS256 JWT signing secret for per-user RBAC auth (generate a strong 32+ char random string in prod)
JWT_SECRET=change_me_to_strong_random_jwt_secret
# JWT expiration in seconds (default: 43200 = 12 hours)
JWT_TTL_SECONDS=43200

# Database seeding guard:
# - In development: auto-seeds ONLY if users/deliveries collections are empty.
# - In production (NODE_ENV=production): disabled by default unless explicitly set to "true".
ENABLE_AUTO_SEED=true

# Autonomous Agent execution mode:
# - "true" (default): runs in-process timer loop (single-instance dev/demo).
# - "false": disables setInterval loop; trigger via Google Cloud Scheduler -> POST /api/agent/tick.
ENABLE_AGENT_LOOP=true

# Google Sign-In (Firebase Auth) provisioning controls:
# - "false" (DEFAULT & RECOMMENDED): strict whitelist — Google Sign-In NEVER auto-creates new accounts.
#   Only emails pre-registered in Firestore `users` (via `npm run user:add` or POST /api/users) can sign in.
# - "true": allows new verified Google accounts to auto-register with least-privilege "courier" role.
GOOGLE_AUTO_REGISTER=false
# Optional comma-separated registered Google emails guaranteed "dispatcher" role on login:
DISPATCHER_EMAILS=

# ------------------------------------------------------------
# OPERATIONAL REGION & SPATIAL CONFIG (100% Dynamic)
# ------------------------------------------------------------
OPERATION_CITY=Surabaya
DEFAULT_ORIGIN_LAT=-7.2652
DEFAULT_ORIGIN_LNG=112.7523
WEATHER_LAT=-7.2575
WEATHER_LNG=112.7521
WEATHER_TIMEZONE=Asia/Jakarta
DELIVERY_MARK_RADIUS_KM=0.2
HUB_CLUSTER_RADIUS_KM=1.5
