# ============================================================
# NusaRoute AI — Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values.
# Never commit .env to version control!
#
# ------------------------------------------------------------
# GOOGLE GEMINI AI
# ------------------------------------------------------------
# How to get: https://aistudio.google.com/ -> Get API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Set to "true" to use mock AI responses (no API key needed)
USE_MOCK_AI=true

# Gemini model to use (latest: gemini-2.5-flash-preview-05-20)
GEMINI_MODEL=gemini-2.5-flash-preview-05-20

# ------------------------------------------------------------
# FIREBASE (Admin SDK — Server Side)
# ------------------------------------------------------------
# How to get:
# 1. Go to https://console.firebase.google.com/
# 2. Create a NEW project (e.g., "nusaroute-ai")
# 3. Project Settings -> Service Accounts
# 4. "Generate New Private Key" -> Download JSON
# 5. Paste the values from that JSON below:
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-service-account@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------
# GOOGLE MAPS
# ------------------------------------------------------------
# How to get: https://console.cloud.google.com/ -> APIs & Services
# Enable: Maps JavaScript API, Directions API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ------------------------------------------------------------
# SERVER CONFIG
# ------------------------------------------------------------
PORT=3000
NODE_ENV=development
# Frontend origin for CORS (default: Vite dev server)
CORS_ORIGIN=http://localhost:5173
