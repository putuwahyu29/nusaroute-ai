# Auto-detect text files and normalize line endings to LF for cross-platform compatibility (Windows, macOS, Linux)
* text=auto eol=lf

# Source code & configs
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.env* text eol=lf
Dockerfile text eol=lf
.gitignore text eol=lf

# Binaries & media assets
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.webp binary
*.mp3 binary
*.wav binary
*.pdf binary
*.pptx binary
